# GitHub token for real contribution calendar data (optional — falls back to mock data)
NEXT_PUBLIC_GITHUB_TOKEN=

# EmailJS credentials for the contact form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# Site URL for sitemap and robots (optional — defaults to https://www.naheel.me)
NEXT_PUBLIC_SITE_URL=
